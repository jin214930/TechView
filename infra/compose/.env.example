# CD가 commit SHA 태그로 게시하는 백엔드 이미지다. 실제 값은 배포 스크립트가 실행 시 덮어쓴다.
BACKEND_IMAGE=ghcr.io/jin214930/techview-backend:0000000000000000000000000000000000000000

# PostgreSQL
POSTGRES_DB=techview
POSTGRES_USER=techview
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# 브라우저 접근 및 인증
CORS_ALLOWED_ORIGIN=https://wardtech.xyz
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_KEY_AT_LEAST_32_BYTES
JWT_ACCESS_TOKEN_EXPIRATION_TIME=30m
JWT_REFRESH_TOKEN_EXPIRATION_TIME=30d
REFRESH_TOKEN_HASH_SECRET_KEY=CHANGE_ME_REFRESH_TOKEN_HASH_SECRET_AT_LEAST_32_BYTES

# OCI Object Storage의 S3 호환 API 설정
AUDIO_STORAGE_BUCKET=techview-audio
AUDIO_STORAGE_REGION=ap-chuncheon-1
AUDIO_STORAGE_ENDPOINT=https://namespace.compat.objectstorage.ap-chuncheon-1.oci.customer-oci.com
AUDIO_STORAGE_ACCESS_KEY=CHANGE_ME_OCI_CUSTOMER_ACCESS_KEY
AUDIO_STORAGE_SECRET_KEY=CHANGE_ME_OCI_CUSTOMER_SECRET_KEY
AUDIO_PRESIGNED_URL_EXPIRATION=5m
AUDIO_MAX_FILE_SIZE=25MB

# 비동기 작업 처리
PROCESSING_JOB_LEASE_DURATION=2m
PROCESSING_WORKER_CONCURRENCY=2
PROCESSING_WORKER_QUEUE_CAPACITY=20
PROCESSING_WORKER_POLLING_DELAY=10s
PROCESSING_WORKER_POLLING_BATCH_SIZE=20

# OpenAI 공통 및 작업별 모델 설정
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_STT_LANGUAGE=ko
OPENAI_STT_TIMEOUT=60s
OPENAI_ANSWER_ANALYSIS_MODEL=gpt-5.6-luna
OPENAI_ANSWER_ANALYSIS_PROMPT_VERSION=answer-analysis-v1
OPENAI_ANSWER_ANALYSIS_MAX_OUTPUT_TOKENS=1000
OPENAI_ANSWER_ANALYSIS_TIMEOUT=60s
OPENAI_INTERVIEW_FEEDBACK_MODEL=gpt-5.6-luna
OPENAI_INTERVIEW_FEEDBACK_PROMPT_VERSION=interview-feedback-v1
OPENAI_INTERVIEW_FEEDBACK_MAX_OUTPUT_TOKENS=2000
OPENAI_INTERVIEW_FEEDBACK_TIMEOUT=90s
